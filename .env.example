# Copy to .env (repo root or backend/) and fill in. Never commit .env.
# The AI layer is optional: without a key QuarterNote still runs (PUSH fully works; PULL shows cited
# evidence passages; Guidance vs Actuals is off). Set ONE of these keys:
#   GROQ_API_KEY      free tier from https://console.groq.com (no payment needed) - recommended
#   GEMINI_API_KEY    free tier from https://aistudio.google.com (no payment needed)
#   ANTHROPIC_API_KEY paid; Claude Haiku + Sonnet routing
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides. Defaults:
#   Groq      -> openai/gpt-oss-20b (bulk work) / openai/gpt-oss-120b (reasoning)
#   Gemini    -> gemini-flash-lite-latest
#   Anthropic -> claude-haiku-5-5 (bulk work) / claude-sonnet-5-5 (reasoning)
# FINN_FAST_MODEL=
# FINN_STRONG_MODEL=

# Set to 1 to force clearly-labelled SIMULATED data in PUSH (offline demos).
FINN_FORCE_SAMPLE=0
